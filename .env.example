# canonical live database and independent signed-vote ledger
LAUNCHSEEDS_DB_PATH=./data/launchseeds-v2.sqlite
# Durable *non-spending* treasury observation journal
LAUNCHSEEDS_TREASURY_DB_PATH=./data/launchseeds-treasury-plans.sqlite
LAUNCHSEEDS_ASSETS_PATH=./data/assets
# Stable HTTPS address of the public application (required for token metadata)
# PUBLIC_BASE_URL=https://launchseeds.xyz
# SOLANA_RPC_URL=https://...
# LAUNCH_BASE_SOL=0.02
# LAUNCHSEEDS_LAUNCH_ENABLED=false
# LAUNCHSEEDS_WORKER_ENABLED=false
# LAUNCHSEEDS_LIVE_OPERATIONS=false
# Optional live API keys (never exposed to the client)
# COLLECTOR_API_KEY=
# JUPITER_API_KEY=
# Optional UID of actual deployed $TOKEN token to show in navigation
# LAUNCHSEEDS_TOKEN_TOKEN_UID=
# Storage quota (uploaded artwork is deduplicated by SHA256)
LAUNCHSEEDS_MAX_ASSETS=1000

# Worker liveness is written by scripts/worker.ts and read by launch endpoints.
# All processes MUST share the same durable filesystem/database volume.
LAUNCHSEEDS_WORKER_HEALTH_DB_PATH=./data/launchseeds-worker-health.sqlite

# In live mode, a trusted reverse proxy must strip and reissue signed
# x-launchseeds-edge-client / x-launchseeds-edge-signature headers. The signature is
# HMAC-SHA256(secret, `launchseeds-edge-v1:${clientId}`). Secret >=32 bytes.
# A shared ingress rate limiter is still REQUIRED when deploying replicas.
# LAUNCHSEEDS_EDGE_CLIENT_SECRET=replace-with-at-least-32-random-bytes

# Optional operator dashboard at /admin; not linked from the public header.
# Leave disabled on public deployments until TLS, trusted ingress and secrets
# are configured. Use strong, independent secrets; never commit their values.
LAUNCHSEEDS_ADMIN_ENABLED=false
# LAUNCHSEEDS_ADMIN_PASSWORD=<random administrator password at least 20 chars>
# LAUNCHSEEDS_ADMIN_SESSION_SECRET=<random secret at least 32 chars>
# Only these registered bgrun processes can be stopped/restarted/deleted.
# Listing and log access requires admin authentication regardless.
# LAUNCHSEEDS_ADMIN_CONTROL_PROCESSES=launchseeds-worker,launchseeds-web
# LAUNCHSEEDS_ADMIN_AUDIT_PATH=./data/admin-audit.ndjson
