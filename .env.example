# The one LaunchSeeds database: tokens, governance, treasury plans and worker health.
# Solard keeps its own encrypted wallet store (SOLARD_DB_PATH).
LAUNCHSEEDS_DB_PATH=./data/launchseeds-v3.sqlite
LAUNCHSEEDS_ASSETS_PATH=./data/assets
# Metadata/image pinning uses Solard uploadPumpMetadata (Pump IPFS), not a public app URL.
# SLRD_MASTER_KEY=<private encrypted-wallet storage secret>
# SOLANA_RPC_URL=https://...
# LAUNCH_BASE_SOL=0.02
# LAUNCHSEEDS_LAUNCH_ENABLED=false
# LAUNCHSEEDS_WORKER_ENABLED=false
# LAUNCHSEEDS_LIVE_OPERATIONS=false
# Optional live API keys (never exposed to the client)
# COLLECTOR_API_KEY=
# JUPITER_API_KEY=
# Optional UID of actual deployed $TOKEN token to show in navigation
# LAUNCHSEEDS_TOKEN_MINT=  (CA of the live $TOKEN token)
# Storage quota (uploaded artwork is deduplicated by SHA256)
LAUNCHSEEDS_MAX_ASSETS=1000

# Worker liveness is written by scripts/worker.ts into LAUNCHSEEDS_DB_PATH and read
# by launch endpoints. All processes MUST share the same durable volume.

# Rate-limit identity: scripts/serve-local.ts (bun run start) binds loopback
# and keys each visitor by the X-Forwarded-For IP that Caddy reverse_proxy sets.
# No secret is needed. Limits are in memory, per web process.

# Optional operator dashboard at /admin; not linked from the public header.
# Leave disabled on public deployments until TLS, trusted ingress and secrets
# are configured. Use strong, independent secrets; never commit their values.
LAUNCHSEEDS_ADMIN_ENABLED=false
# LAUNCHSEEDS_ADMIN_PASSWORD=<random administrator password at least 20 chars>
# LAUNCHSEEDS_ADMIN_SESSION_SECRET=<random secret at least 32 chars>
# Only these registered bgrun processes can be stopped/restarted/deleted.
# Listing and log access requires admin authentication regardless.
# LAUNCHSEEDS_ADMIN_CONTROL_PROCESSES=launchseeds-worker,launchseeds-web
# LAUNCHSEEDS_ADMIN_AUDIT_PATH=./data/admin-audit.ndjson

# Server-only IPFS credential. Solard uses Pinata when present.
PINATA_JWT=

# Optional sponsor wallet; one claim per IP per 24h, no global budget cap.
# FREE_LAUNCH_ENABLED=true
# FREE_LAUNCH_WALLET=launchseeds-free-launch
# Production image generation uses the isolated account provisioned by scripts/provision-image-runtime.sh.
# LAUNCHSEEDS_IMAGE_GENERATION=true
# LAUNCHSEEDS_IMAGE_CODEX_BIN=/usr/local/bin/launchseeds-image-codex
# LAUNCHSEEDS_IMAGE_WORK_DIR=/var/lib/launchseeds-imagegen/work
# LAUNCHSEEDS_IMAGE_STYLE_REFERENCE=/opt/launchseeds-imagegen/style-reference.png
