# LaunchSeeds settings. Keep real values out of git.

# Database and uploaded images
LAUNCHSEEDS_DB_PATH=./data/launchseeds.sqlite
LAUNCHSEEDS_ASSETS_PATH=./data/media
LAUNCHSEEDS_MAX_ASSETS=10000

# Public site address (used for same-origin checks and links)
PUBLIC_BASE_URL=https://launchseeds.xyz

# Solana
SOLANA_RPC_URL=
# Encrypted wallet store and its key (Solard)
SOLARD_DB_PATH=./data/solard.sqlite
SLRD_MASTER_KEY=

# Launches: kept in the treasury per launch (SOL), the daily limit, and the
# switches that allow real transactions
LAUNCH_BASE_SOL=0.001
LAUNCHSEEDS_DAILY_LAUNCHES=20
# The most one launch's bundle buys (SOL). Unset: no launches.
LAUNCHSEEDS_MAX_BUNDLE_SOL=0.5
# Launches pause once the last 24 hours lost this much (SOL). Unset: no limit.
LAUNCHSEEDS_DAILY_LOSS_SOL=0.3
LAUNCHSEEDS_LAUNCH_ENABLED=false
LAUNCHSEEDS_WORKER_ENABLED=false
LAUNCHSEEDS_LIVE_OPERATIONS=false
LAUNCHSEEDS_LAUNCH_BUNDLES=true
LAUNCHSEEDS_USER_BATCHES=true

# Coin metadata pinning
PINATA_JWT=

# Optional image generation for the launch form
LAUNCHSEEDS_IMAGE_GENERATION=false
FAL_API_KEY=

# Optional admin dashboard at /admin. Leave disabled until TLS and secrets are set.
LAUNCHSEEDS_ADMIN_ENABLED=false
LAUNCHSEEDS_ADMIN_PASSWORD=
LAUNCHSEEDS_ADMIN_SESSION_SECRET=
LAUNCHSEEDS_ADMIN_WALLETS=
